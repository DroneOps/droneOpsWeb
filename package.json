{
	"name": "droneopsweb",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "npm run build:docs && vite build",
		"preview": "vite preview",
		"build:docs": "cd documentacion && npx quartz build -o ../static/docs && node inject-back-button.mjs ../static/docs",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"autoprefixer": "^10.5.4",
		"postcss": "^8.5.26",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@mediapipe/tasks-vision": "^1.1.0",
		"@supabase/ssr": "^0.12.5",
		"@supabase/supabase-js": "^2.112.4",
		"date-fns": "^4.4.0"
	}
}
